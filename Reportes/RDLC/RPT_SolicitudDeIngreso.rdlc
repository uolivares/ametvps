          <Textbox Name="Textbox95">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>                                                            Con la aceptación de la presente, autorizo al Secretario de Finanzas se proceda al descuento en forma automática de la cuota sindical determinada por asamblea y establecida por ley.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#231f20</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox8</rd:DefaultName>
            <Top>18.01486cm</Top>
            <Left>0.09653cm</Left>
            <Height>1.56878cm</Height>
            <Width>17.82938cm</Width>
            <ZIndex>40</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.web>
        <authorization>
          <allow roles="Operador" />
          <allow roles="Consultas" />          
          <allow roles="Liquidador" />
            <deny users="*" />
        </authorization>
			<customErrors mode="Off"/>
    </system.web>
</configuration>